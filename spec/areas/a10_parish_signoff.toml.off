# DROPPED in W4 round 2 (fixer, per the cross-check and G1's own recommendation): renamed to .toml.off, so neither
# build reads it. Do not rename it back as part of a main-only build step; restoring it is the user's sign-off call.
# Why: predicted net b -0.0007 vs main (under the 0.0015 oklab noise, so round 2 could not confirm it), parish main
# already passes b (-0.0012), and the full-variant parish darkening (-0.43 vs -0.40) thins burg - parish and
# parish - darkroot_garden against +-0.30.
# G1 sign-off: Parish cooling (ToneCorrect 11). README section 6: colour resting on unverified single sources
# needs the user's approval on its first capture. Drop this file (rename to .toml.off) to remove the move on its own;
# a10_g1.toml and a10_burg_parish_signoff.toml validate without it.
# Round 2 (W4 G1): split out of a10_burg_parish_signoff.toml, saturation raised. Round-2 reviewer recommendation:
# DROP unless round 2 shows the cooling still buys >= 0.0015 b (oklab noise) over main. Reason: parish main already
# passes b (-0.0012 vs -0.012..+0.001); round 1 measured this edit at b -0.0021 / a -0.0011 but sat x0.999 -> x0.940
# (FAIL >= 0.97, walls x0.90-0.92). Parish's chroma IS the yellow, so the saturation payback that fixes sat gives
# most of the b back.

area = "a10"

[[edit]]
bank = "ToneCorrectBank"
rows = [11]
op = "set"
fields = { brightnessR = 1.03, brightnessB = 1.065, saturation = 0.97 }
why = "parish: less yellow interior with G held so the shade does not drift purple (G1: brightnessR 1.05->1.02-1.04, brightnessB 1.05->1.05-1.08). Round 1 (saturation 0.927) measured b -0.0021, a -0.0011, sat x0.940 (FAIL >= 0.97). Round 2: saturation 0.927 -> 0.97 (x1.047; rel 1.078 of vanilla 0.90, band max 1.035) pays the chroma back: est. sat x0.98, b -0.0033 -> -0.0019 (the cooling then nets only -0.0007 vs main, under noise; a ~-0.001). ToneCorrect 11 is m10_01 only (Burg/Parish interiors; burg's view is on ToneCorrect 10). Sign-off: Parish cooling (recommend drop if r2 b gain < 0.0015)"
